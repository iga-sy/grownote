GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ローカル開発では未設定のままでOK(自動的に ./db/shinnyu.db というローカルファイルを使う)。
# 本番(Vercelなど)では Turso のデータベースURL・トークンを設定する。
# 例: TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 両方設定すると、サイト全体にBasic認証がかかる(公開URLで運用する場合に設定)。
# ローカル開発では未設定のままでOK(認証なしでアクセスできる)。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
